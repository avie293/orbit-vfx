{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "cc.avie.orbitvfx.fabric.OrbitFabricClient"
    ]
  },
  "mixins": [
    "orbitvfx.mixins.json",
    "orbitvfx-fabric.mixins.json"
  ],
  "depends": {
    "fabric-api": "*",
    "tabbylib": ">=${tabbylib_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "avie.discord": "https://discord.gg/57TZ8BJvd9"
      }
    }
  }
}
